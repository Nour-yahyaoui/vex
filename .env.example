# Copy this file to .env.local and fill in real values.
#
# Nothing below is required just to browse the desktop, use the terminal,
# or write/run Python in VexBit's "vexpy" mode — those work with zero
# config. Everything here only gates sign-in, the AI assistant, and the
# real-code Sandbox run mode.

# --- Auth (required to get past the sign-in screen at all) ---------------
# NextAuth v5 needs a secret to sign session cookies. Generate one with:
#   openssl rand -base64 33
AUTH_SECRET=

# OAuth apps — you only need to fill in ONE provider to sign in, but the
# app calls both Google() and GitHub() unconditionally, so leaving a
# provider's vars blank just means that provider's button won't work
# (it won't crash the app).
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
GITHUB_ID=
GITHUB_SECRET=

# --- Database (required by the auth adapter to store user rows) ----------
# Neon Postgres connection string: https://neon.tech
DATABASE_URL=

# --- AI assistant (Vex Assistant chat panel inside VexBit) ---------------
# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# Upstash Redis — used to rate-limit the AI assistant and Sandbox runs.
# IMPORTANT: the AI chat route fails CLOSED without this (returns a 503
# "isn't available yet") rather than running unrate-limited, since it's a
# paid external API call on every request. If the assistant seems totally
# dead, this is the first thing to check.
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sandbox run mode (optional — real Python/JS execution) --------------
# Only needed if you want VexBit's "sandbox" run mode (vs the free/instant
# "vexpy" mode) to work locally. Requires a Vercel project linked via
# `vercel link`, or VERCEL_TOKEN/VERCEL_ORG_ID/VERCEL_PROJECT_ID set — see
# https://vercel.com/docs/vercel-sandbox for current setup steps.
